{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "server = .; database = MediBook; integrated security = true ; trustservercertificate = true"
  },
  "Jwt": {
    "Key": "REPLACE-THIS-WITH-A-LONG-RANDOM-SECRET-AT-LEAST-32-CHARACTERS",
    "Issuer": "MediBookApi",
    "Audience": "MediBookClient",
    "ExpiryMinutes": 30
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "FileStorage": {
    "BasePath": "App_Data/uploads"
  }
}
